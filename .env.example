# Copy this file to .env.local for local development.
# In Render, set these as Environment Variables on the service instead of committing a .env file.

# --- Supabase ---
# Project URL and keys from Supabase project settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only key, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Telegram Bot API ---
# Bot token from @BotFather, and the chat/channel ID reports are sent to.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Google Analytics 4 Data API (GA4 자동 수집) ---
# GA4 속성 ID (숫자만, "properties/" 접두사 없이). GA4 관리 > 속성 세부정보에서 확인.
GA4_PROPERTY_ID=
# Google Cloud Console에서 만든 서비스 계정의 이메일/private key. 이 서비스 계정을
# GA4 관리 > 속성 액세스 관리에 뷰어 이상 권한으로 추가해야 함.
GOOGLE_CLIENT_EMAIL=
# PEM 전체를 한 줄로 붙여넣고 개행은 리터럴 \n으로 이스케이프. 절대 커밋하지 말 것.
GOOGLE_PRIVATE_KEY=

# --- Google Sheets API (DB 자동 동기화) ---
# 위 GOOGLE_CLIENT_EMAIL / GOOGLE_PRIVATE_KEY 서비스 계정을 그대로 재사용한다 —
# Google Cloud Console에서 같은 프로젝트에 Sheets API를 추가로 활성화하고,
# 이 서비스 계정 이메일을 대상 스프레드시트에 공유해야 함. marketing_attribution
# 탭 자동 생성/기록까지 쓰려면 "뷰어"가 아니라 "편집자"로 공유해야 함(코첫/코재/눈
# 등 상담팀 탭에는 이 앱이 절대 쓰지 않음 — marketing_attribution 탭만 씀).
# 스프레드시트 ID는 시트 URL의 /d/ 와 /edit 사이 문자열.
GOOGLE_SHEETS_SPREADSHEET_ID=

# 실제 스프레드시트의 attribution 탭 이름이 기본값("marketing_attribution")과
# 다르면(예: 상담팀이 실수로 편집하지 않도록 접미사를 붙인 경우) 정확히 일치하는
# 이름으로 설정. 자세한 내용은 docs/lead-attribution-setup.md 참고.
LEADS_ATTRIBUTION_SHEET_NAME=marketing_attribution
# DBcart(또는 랜딩/폼 도구)가 POST /api/leads-attribution/ingest 호출 시 보낼
# `Authorization: Bearer <값>`. CRON_SECRET과는 별개의 값을 사용 — 외부 도구가
# 들고 있는 비밀이므로 독립적으로 교체 가능해야 함. 긴 무작위 문자열 생성 후
# 절대 커밋하지 말 것.
LEADS_ATTRIBUTION_INGEST_SECRET=

# --- Gmail API (Meta 예약 보고서 이메일 자동 수집) ---
# From Google Cloud Console > APIs & Services > Credentials (OAuth client, Web application).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Must exactly match a redirect URI registered on the OAuth client, e.g.
# https://<your-app>.onrender.com/api/auth/gmail/callback (or http://localhost:3000/... in dev).
GMAIL_REDIRECT_URI=

# --- Cron ---
# Shared secret Render's Cron Job sends as `Authorization: Bearer <value>` to
# POST /api/sync/meta, POST /api/sync/ga4, and POST /api/sync/leads.
# Generate a long random string; never commit the value.
CRON_SECRET=
